{
    "name": "locutus-backend",
    "version": "0.0.0",
    "description": "Backend for the Locutus AI Assistant",
    "main": "dist/server.js",
    "type": "module",
    "repository": "https://github.com/gwenphalan/locutus-backend.git",
    "author": "Gwen Phalan <gwen.phalan@gmail.com>",
    "license": "MIT",
    "packageManager": "pnpm@10.30.3",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsup src/server.ts --format esm --dts --clean",
        "start": "node dist/server.js",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "watch": "tsc --watch --preserveWatchOutput",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint:staged": "lint-staged",
        "prepare": "husky",
        "db:up": "docker compose up -d redis",
        "db:down": "docker compose stop redis && docker compose rm -f redis",
        "clean": "rm -rf dist/"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "prettier --write",
            "eslint --fix --max-warnings=0 --no-warn-ignored"
        ],
        "*.{json,md}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@eslint/js": "^9.39.1",
        "@types/node": "^24.10.1",
        "@typescript-eslint/eslint-plugin": "^8.47.0",
        "@typescript-eslint/parser": "^8.47.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "nodemon": "^3.1.11",
        "prettier": "^3.6.2",
        "ts-node": "^10.9.2",
        "tsup": "^8.5.1",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.47.0"
    },
    "dependencies": {
        "@openrouter/ai-sdk-provider": "^1.2.5",
        "@openrouter/sdk": "^0.1.27",
        "ai": "^5.0.98",
        "cache-manager": "^7.2.5",
        "dotenv": "^17.2.3",
        "fastify": "^5.6.2",
        "fastify-winston": "^2.0.2",
        "js-tiktoken": "^1.0.21",
        "redis": "^5.10.0",
        "vitest": "^4.0.14",
        "winston": "^3.18.3",
        "zod": "^4.1.12"
    }
}
